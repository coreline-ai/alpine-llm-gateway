<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/demo_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/demo_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <Button
            android:id="@+id/backButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/add_provider"
            android:textColor="@color/demo_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/providerTypeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="@string/provider_type"
                android:textColor="@color/demo_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/providerDescriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:textColor="@color/demo_text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/labelInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/provider_identity"
                android:inputType="textCapWords"
                android:singleLine="true" />

            <EditText
                android:id="@+id/authorizationEndpointInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/authorization_endpoint"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/tokenEndpointInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/token_endpoint"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/inferenceEndpointInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/inference_endpoint"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/clientIdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/public_client_id"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:id="@+id/scopesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/oauth_scopes"
                android:inputType="text"
                android:maxLines="3" />

            <EditText
                android:id="@+id/modelInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/default_model"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:id="@+id/callbackPortInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/callback_port"
                android:inputType="number"
                android:singleLine="true" />

            <EditText
                android:id="@+id/anthropicBetaInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/anthropic_beta"
                android:inputType="text"
                android:singleLine="true"
                android:visibility="gone" />

            <EditText
                android:id="@+id/googleProjectInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/google_project_id"
                android:inputType="text"
                android:singleLine="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/validationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/design_default_color_error"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
