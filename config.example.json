{
  "host": "127.0.0.1",
  "port": 8787,
  "provider": "openai-compatible",
  "base_url": "https://api.openai.com/v1",
  "api_key_env": "LLM_API_KEY",
  "default_model": "gpt-4o-mini",
  "allowed_models": [
    "gpt-4o-mini"
  ],
  "model_catalog": [
    {
      "id": "gpt-4o-mini",
      "display_name": "GPT-4o mini",
      "provider": "openai-compatible",
      "modalities": ["text_input", "text_output"]
    }
  ],
  "max_input_bytes": 1048576,
  "max_output_tokens": 4096,
  "max_messages": 64,
  "max_response_bytes": 8388608,
  "max_stream_event_bytes": 1048576,
  "max_stream_bytes": 33554432,
  "timeout_seconds": 120,
  "provider_retry_max_attempts": 3,
  "provider_retry_initial_backoff_seconds": 0.5,
  "provider_retry_max_backoff_seconds": 8.0,
  "provider_retry_jitter_ratio": 0.2,
  "provider_circuit_failure_threshold": 5,
  "provider_circuit_recovery_seconds": 30,
  "allow_passthrough": false
}
