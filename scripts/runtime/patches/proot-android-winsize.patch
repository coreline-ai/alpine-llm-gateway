+static int override_android_terminal_winsize(Tracee *tracee)
+{
+	const char *path;
+	FILE *file;
+	unsigned int rows;
+	unsigned int columns;
+	struct winsize size;
+	word_t output;
+	int status;
+
+	path = getenv("PROOT_WINSIZE_FILE");
+	if (path == NULL || path[0] != '/') {
+		record_android_terminal_winsize("NO_STATE", 0, 0);
+		return 0;
+	}
+	file = fopen(path, "r");
+	if (file == NULL) {
+		record_android_terminal_winsize("OPEN_FAILED", 0, 0);
+		return 0;
+	}
+	status = fscanf(file, "%u %u", &rows, &columns);
+	fclose(file);
+	if (status != 2 || rows == 0 || columns == 0 || rows > 1000 || columns > 1000) {
+		record_android_terminal_winsize("PARSE_FAILED", rows, columns);
+		return 0;
+	}
 
+	memset(&size, 0, sizeof(size));
+	size.ws_row = (unsigned short) rows;
+	size.ws_col = (unsigned short) columns;
+	output = peek_reg(tracee, CURRENT, SYSARG_3);
+	if (write_data(tracee, output, &size, sizeof(size)) < 0) {
+		record_android_terminal_winsize("WRITE_FAILED", rows, columns);
+		return 0;
+	}
+	record_android_terminal_winsize("APPLIED", rows, columns);
+	return 1;
+}
