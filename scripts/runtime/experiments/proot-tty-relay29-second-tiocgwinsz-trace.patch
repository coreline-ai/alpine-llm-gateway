+/*
+ * Probe-only second-TIOCGWINSZ recorder.  After the first successful guest
+ * TIOCGWINSZ it records whether the next guest TIOCGWINSZ enters and whether
+ * it returns success or error.  The record uses a closed enum only: no
+ * terminal bytes, command, argument, path, PID, fd number or errno value is
+ * ever stored.  It is never a production resize implementation.
+ */
+static bool second_tiocgwinsz_first_exit_seen = false;
+static bool second_tiocgwinsz_enter_seen = false;
+static Tracee *second_tiocgwinsz_tracee = NULL;
+
+static const char *second_tiocgwinsz_trace_path(void)
+{
+	static bool initialized = false;
+	static const char *path = NULL;
+
+	if (!initialized) {
+		path = getenv("PROOT_TTY_POST_WINSIZE_INPUT_TRACE");
+		initialized = true;
+	}
+
+	return path != NULL && path[0] != '\0' ? path : NULL;
+}
+
+static void record_second_tiocgwinsz_stage(const char *stage)
+{
+	const char *path = second_tiocgwinsz_trace_path();
+	int fd;
+
+	if (path == NULL)
+		return;
+
+	fd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC | O_NOFOLLOW, 0600);
+	if (fd < 0)
+		return;
+
+	(void) write(fd, "schema=1 event=POST_TIOCGWINSZ_SECOND_GET stage=",
+		     sizeof("schema=1 event=POST_TIOCGWINSZ_SECOND_GET stage=") - 1);
+	(void) write(fd, stage, strlen(stage));
+	(void) write(fd, "\n", 1);
+	(void) close(fd);
+}
+
+static void trace_second_tiocgwinsz_enter(Tracee *tracee)
+{
+	if (!second_tiocgwinsz_first_exit_seen || second_tiocgwinsz_enter_seen ||
+	    second_tiocgwinsz_trace_path() == NULL)
+		return;
+
+	if (get_sysnum(tracee, CURRENT) != PR_ioctl ||
+	    peek_reg(tracee, CURRENT, SYSARG_2) != TIOCGWINSZ)
+		return;
+
+	second_tiocgwinsz_enter_seen = true;
+	second_tiocgwinsz_tracee = tracee;
+	record_second_tiocgwinsz_stage("second_tiocgwinsz_enter");
+}
+
+static void trace_second_tiocgwinsz_exit(Tracee *tracee)
+{
+	word_t result;
+
+	if (second_tiocgwinsz_trace_path() == NULL ||
+	    get_sysnum(tracee, ORIGINAL) != PR_ioctl ||
+	    peek_reg(tracee, ORIGINAL, SYSARG_2) != TIOCGWINSZ)
+		return;
 
+	result = peek_reg(tracee, CURRENT, SYSARG_RESULT);
+	if (!second_tiocgwinsz_first_exit_seen) {
+		if ((long) result >= 0) {
+			second_tiocgwinsz_first_exit_seen = true;
+			record_second_tiocgwinsz_stage("first_tiocgwinsz_exit_ok");
+		}
+		return;
+	}
+
+	if (tracee != second_tiocgwinsz_tracee)
+		return;
+
+	record_second_tiocgwinsz_stage((long) result >= 0
+		? "second_tiocgwinsz_exit_ok" : "second_tiocgwinsz_exit_error");
+	second_tiocgwinsz_tracee = NULL;
+}
+
