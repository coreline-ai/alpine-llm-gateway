+/*
+ * Probe-only physical job-control observation. PRoot virtualizes process
+ * groups for the guest, so /proc/self/stat cannot prove whether the tracee
+ * that actually issued a tty ioctl belongs to the host tty foreground group.
+ * Persist fixed enum-like stages only; never a PID, pgrp, command, or path.
+ */
+static void record_active_tty_tracee_group(Tracee *tracee)
+{
+	const char *record_path = getenv("PROOT_TTY_DIAGNOSTIC_FILE");
+	static int last_state = -1;
+	static const char foreground_record[] =
+		"schema=1 event=SIGWINCH stage=active_tty_tracee_foreground\n";
+	static const char background_record[] =
+		"schema=1 event=SIGWINCH stage=active_tty_tracee_background\n";
+	int state;
+	int output_fd;
+
+	if (record_path == NULL || record_path[0] == '\0')
+		return;
+	state = getpgid(tracee->pid) == tcgetpgrp(STDIN_FILENO) ? 1 : 0;
+	if (state == last_state)
+		return;
+	last_state = state;
+	output_fd = open(record_path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+	if (output_fd < 0)
+		return;
+	if (state == 1)
+		(void) write(output_fd, foreground_record, sizeof(foreground_record) - 1);
+	else
+		(void) write(output_fd, background_record, sizeof(background_record) - 1);
+	close(output_fd);
+}
