+/*
+ * Probe-only signal topology diagnostic. The records are fixed literals and
+ * deliberately carry no tracee PID, command, path, terminal bytes, or user
+ * content. In the tracee-foreground experiment PRoot itself is background,
+ * so recording source-level foreground assignment and tracee reinjection
+ * distinguishes physical terminal delivery from any tracer-side relay.
+ */
+static int tty_signal_diagnostic_fd = -1;
+/*
+ * Relay24 virtual winsize control is Probe-only. A direct session supervisor
+ * stores exactly four big-endian bytes (columns, rows) in a private inherited
+ * memfd. On each successful guest TIOCGWINSZ exit PRoot reads that fixed slot
+ * and replaces the guest result. No PRoot thread, post-launch signal, FIFO,
+ * polling loop, guest PID lookup or terminal-data route is involved.
+ */
+static int tty_virtual_winsize_fd = -1;
+
+static void record_tty_virtual_winsize_stage(const char *stage)
+{
+	static const char ready_record[] =
+		"schema=1 event=VIRTUAL_WINSIZE stage=virtual_winsize_fd_ready\n";
+	static const char applied_record[] =
+		"schema=1 event=VIRTUAL_WINSIZE stage=virtual_winsize_read_applied\n";
+
+	if (tty_signal_diagnostic_fd < 0)
+		return;
+	if (strcmp(stage, "ready") == 0)
+		(void) write(tty_signal_diagnostic_fd, ready_record, sizeof(ready_record) - 1);
+	else if (strcmp(stage, "applied") == 0)
+		(void) write(tty_signal_diagnostic_fd, applied_record, sizeof(applied_record) - 1);
+}
+
+static void initialize_tty_virtual_winsize()
+{
+	const char *value = getenv("PROOT_TTY_VIRTUAL_WINSIZE_FD");
+	char *end = NULL;
+	long parsed_fd;
+	int flags;
+
+	if (tty_virtual_winsize_fd >= 0 || value == NULL || value[0] == '\0')
+		return;
+	errno = 0;
+	parsed_fd = strtol(value, &end, 10);
+	if (errno != 0 || end == value || *end != '\0' || parsed_fd < 3 || parsed_fd > 1024)
+		return;
+	flags = fcntl((int) parsed_fd, F_GETFD);
+	if (flags < 0 || fcntl((int) parsed_fd, F_SETFD, flags | FD_CLOEXEC) != 0)
+		return;
+	tty_virtual_winsize_fd = (int) parsed_fd;
+	record_tty_virtual_winsize_stage("ready");
+}
+
+bool proot_tty_virtual_winsize(struct winsize *size)
+{
+	unsigned char frame[4];
+	unsigned int columns;
+	unsigned int rows;
+
+	if (size == NULL || tty_virtual_winsize_fd < 0 ||
+		pread(tty_virtual_winsize_fd, frame, sizeof(frame), 0) != (ssize_t) sizeof(frame))
+		return false;
+	columns = ((unsigned int) frame[0] << 8) | frame[1];
+	rows = ((unsigned int) frame[2] << 8) | frame[3];
+	if (columns == 0 || rows == 0 || columns > 1000 || rows > 1000)
+		return false;
+	size->ws_col = (unsigned short) columns;
+	size->ws_row = (unsigned short) rows;
+	size->ws_xpixel = 0;
+	size->ws_ypixel = 0;
+	record_tty_virtual_winsize_stage("applied");
+	return true;
+}
