+/*
+ * Phase-1 diagnostic only.  It is compiled into a Probe-exclusive PRoot
+ * artifact, never the production launcher.  The record intentionally omits
+ * tracee PID, command, path, terminal bytes, and all user-controlled text.
+ */
+static void record_tty_winsize_diagnostic(
+	Tracee *tracee,
+	word_t syscall_result,
+	const char *event,
+	const char *stage,
+	int read_size_before_result
+)
+{
+	const char *record_path;
+	const char *expected_text;
+	char *end = NULL;
+	char proc_fd_path[64];
+	char proc_comm_path[64];
+	char comm[64];
+	char record[340];
+	struct stat fd_stat;
+	struct winsize size = {0};
+	unsigned long long expected_rdev;
+	unsigned long long fd_rdev = 0;
+	int fd;
+	int inspected_fd = -1;
+	int fd_is_tty = 0;
+	int same_rdev = 0;
+	const char *tracee_kind = "other";
+	int rows = 0;
+	int columns = 0;
+	int output_fd;
+	int length;
+
+	record_path = getenv("PROOT_TTY_DIAGNOSTIC_FILE");
+	expected_text = getenv("PROOT_TTY_DIAGNOSTIC_EXPECTED_RDEV");
+	if (record_path == NULL || expected_text == NULL || record_path[0] == '\0')
+		return;
+
+	errno = 0;
+	expected_rdev = strtoull(expected_text, &end, 10);
+	if (errno != 0 || end == expected_text || *end != '\0')
+		return;
+
+	fd = (int) peek_reg(tracee, ORIGINAL, SYSARG_1);
+	if (fd >= 0 && fd <= 1048576 &&
+		snprintf(proc_fd_path, sizeof(proc_fd_path), "/proc/%d/fd/%d", tracee->pid, fd) > 0) {
+		inspected_fd = open(proc_fd_path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+		if (inspected_fd >= 0) {
+			fd_is_tty = isatty(inspected_fd) ? 1 : 0;
+			if (fstat(inspected_fd, &fd_stat) == 0) {
+				fd_rdev = (unsigned long long) fd_stat.st_rdev;
+				same_rdev = fd_rdev == expected_rdev ? 1 : 0;
+			}
+			close(inspected_fd);
+		}
+	}
+	if (snprintf(proc_comm_path, sizeof(proc_comm_path), "/proc/%d/comm", tracee->pid) > 0) {
+		int comm_fd = open(proc_comm_path, O_RDONLY | O_CLOEXEC);
+		if (comm_fd >= 0) {
+			ssize_t comm_length = read(comm_fd, comm, sizeof(comm) - 1);
+			close(comm_fd);
+			if (comm_length > 0) {
+				comm[comm_length] = '\0';
+				if (strncmp(comm, "stty", 4) == 0)
+					tracee_kind = "busybox";
+				else if (strncmp(comm, "tty-winsize-pro", 15) == 0)
+					tracee_kind = "tty_helper";
+			}
+		}
+	}
+
+	if ((read_size_before_result || (long) syscall_result == 0) &&
+		read_data(tracee, &size, peek_reg(tracee, ORIGINAL, SYSARG_3), sizeof(size)) == 0) {
+		rows = (int) size.ws_row;
+		columns = (int) size.ws_col;
+	}
+
+	length = snprintf(
+		record,
+		sizeof(record),
+		"schema=1 event=%s stage=%s tracee_kind=%s fd_is_tty=%d fd_rdev=%llu expected_rdev=%llu same_rdev=%d rows=%d columns=%d result=%ld\n",
+		event,
+		stage,
+		tracee_kind,
+		fd_is_tty,
+		fd_rdev,
+		expected_rdev,
+		same_rdev,
+		rows,
+		columns,
+		(long) syscall_result
+	);
+	if (length <= 0 || (size_t) length >= sizeof(record))
+		return;
+
+	output_fd = open(record_path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+	if (output_fd < 0)
+		return;
+	(void) write(output_fd, record, (size_t) length);
+	close(output_fd);
+}
