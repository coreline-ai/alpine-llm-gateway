+/*
+ * Probe-only signal topology diagnostic. The records are fixed literals and
+ * deliberately carry no tracee PID, command, path, terminal bytes, or user
+ * content. PRoot owns the foreground host process group, so recording both
+ * host receipt and ptrace reinjection distinguishes the two signal paths.
+ */
+static int tty_signal_diagnostic_fd = -1;
+
+static void record_tty_signal_diagnostic(
+	int signum,
+	siginfo_t *siginfo UNUSED,
+	void *ucontext UNUSED
+)
+{
+	static const char host_record[] =
+		"schema=1 event=SIGWINCH stage=host_received\n";
+
+	if (signum == SIGWINCH && tty_signal_diagnostic_fd >= 0)
+		(void) write(tty_signal_diagnostic_fd, host_record, sizeof(host_record) - 1);
+}
+
+static void record_tty_signal_tracee_stage(const char *stage)
+{
+	static const char stopped_record[] =
+		"schema=1 event=SIGWINCH stage=tracee_stopped\n";
+	static const char restarted_record[] =
+		"schema=1 event=SIGWINCH stage=tracee_restarted\n";
+
+	if (tty_signal_diagnostic_fd < 0)
+		return;
+	if (strcmp(stage, "tracee_stopped") == 0)
+		(void) write(tty_signal_diagnostic_fd, stopped_record, sizeof(stopped_record) - 1);
+	else if (strcmp(stage, "tracee_restarted") == 0)
+		(void) write(tty_signal_diagnostic_fd, restarted_record, sizeof(restarted_record) - 1);
+}
+
+static void initialize_tty_signal_diagnostic()
+{
+	const char *path = getenv("PROOT_TTY_DIAGNOSTIC_FILE");
 
+	if (path != NULL && path[0] != '\0')
+		tty_signal_diagnostic_fd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+}
